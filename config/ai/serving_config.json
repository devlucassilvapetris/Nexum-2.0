{
  "vllm": {
    "model": "./checkpoints/final",
    "tensor_parallel_size": 1,
    "gpu_memory_utilization": 0.9,
    "max_model_len": 2048,
    "dtype": "float16",
    "trust_remote_code": true
  },
  "ray_serve": {
    "enabled": true,
    "num_replicas": 1,
    "max_concurrent_queries": 100,
    "autoscaling_config": {
      "min_replicas": 1,
      "max_replicas": 4,
      "target_num_ongoing_requests_per_replica": 5
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "allowed_origins": ["*"]
  },
  "generation": {
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 40,
    "max_tokens": 512,
    "presence_penalty": 0.0,
    "frequency_penalty": 0.0
  }
}
