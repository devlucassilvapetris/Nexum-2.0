{
  "model": {
    "base_model": "unsloth/llama-3-8b-bnb-4bit",
    "model_type": "llama",
    "max_seq_length": 2048,
    "load_in_4bit": true,
    "dtype": "float16"
  },
  "training": {
    "output_dir": "./checkpoints",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 2e-4,
    "warmup_steps": 10,
    "logging_steps": 10,
    "save_steps": 100,
    "eval_steps": 100,
    "optim": "adamw_8bit",
    "weight_decay": 0.01,
    "lr_scheduler_type": "cosine",
    "gradient_checkpointing": true,
    "fp16": true
  },
  "lora": {
    "r": 16,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "lora_alpha": 16,
    "lora_dropout": 0,
    "bias": "none",
    "use_gradient_checkpointing": true,
    "random_state": 3407
  },
  "data": {
    "train_file": "./data/train.jsonl",
    "validation_file": "./data/validation.jsonl",
    "max_samples": null,
    "preprocessing_num_workers": 4
  },
  "wandb": {
    "enabled": true,
    "project": "nexum-finetuning",
    "entity": null,
    "run_name": null
  }
}
